{
  "name": "mergedoc",
  "version": "1.0.0",
  "description": "Automated release documentation — AI-powered changelog generation from merged PRs.",
  "main": "dist/index.js",
  "scripts": {
    "lint": "tsc --noEmit",
    "build": "ncc build src/index.ts -o dist --source-map --license licenses.txt",
    "package": "ncc build src/index.ts -o dist --minify --license licenses.txt",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ArslanYM/mergedoc.git"
  },
  "keywords": [
    "github-action",
    "changelog",
    "release-notes",
    "llm",
    "automation"
  ],
  "author": "Arsalan Yaqoob Malik",
  "license": "MIT",
  "dependencies": {
    "@actions/core": "^1.11.1",
    "@actions/exec": "^1.1.1",
    "@actions/github": "^6.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.0",
    "@vercel/ncc": "^0.38.3",
    "typescript": "^5.7.3",
    "vitest": "^3.0.0"
  }
}
